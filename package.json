{
  "name": "playwright-demo",
  "version": "1.0.0",
  "description": "Playwright demo to download a PDF and package as a Windows 10 executable",
  "main": "download-pdf.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "download": "node download-pdf.js",
    "download:browser": "node download-pdf.js --browser",
    "build:exe": "npx pkg download-pdf.js --targets node20-win-x64 --output dist/pdf-downloader.exe",
    "build:exe:all": "npx pkg download-pdf.js --targets node20-win-x64,node20-linux-x64,node20-macos-x64 --output dist/pdf-downloader"
  },
  "keywords": ["playwright", "pdf", "download", "automation"],
  "author": "",
  "license": "ISC",
  "pkg": {
    "assets": [
      "node_modules/playwright/**/*",
      "node_modules/@playwright/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@yao-pkg/pkg": "^6.14.2",
    "playwright": "^1.59.1"
  }
}
